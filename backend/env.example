# P2P Payment Ledger - Required Environment Variables
# Copy this file, fill in your values, and export as environment variables.
# NEVER commit real credentials. This file is safe to commit (example values only).

# PostgreSQL connection
DB_URL=jdbc:postgresql://localhost:5432/payment_ledger
DB_USERNAME=postgres
DB_PASSWORD=your_database_password_here

# JWT signing secret - minimum 32 characters (256 bits recommended)
JWT_SECRET=your_jwt_secret_here_minimum_32_characters_long
